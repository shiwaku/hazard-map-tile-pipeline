# 例3: 浸水深の実数値 → 数値PNG
#
# 福島県「津波浸水想定」の最大浸水深データ。浸水想定区域図データ電子化ガイドラインの
# MAXALL（最大包絡）形式そのままで公開されており、属性 `z` に浸水深が実数（m）で入る。
# 10mメッシュ・EPSG:2451（平面直角座標系IX系）。
#
# なぜ洪水ではないか:
#   洪水浸水想定区域の公開データは、国土数値情報も都道府県公開分も浸水深を
#   ランクコードで持っており、実数値の面データが公開されていない。実数値を
#   扱う経路を検証するために、実数値で公開されている津波データを使っている。
#   パイプラインは災害種別を区別しない（入力の性質だけで分岐する）。
#
# ライセンス: CC BY 2.1 JP（福島県オープンデータ利用規約）
# 出典URL: https://www.pref.fukushima.lg.jp/sec/41045a/tsunami-shinsuisoutei.html

DATASET_ID="fukushima-depth-numeric"
SRC_DIR="data/fukushima-depth"

# 14 地域海岸ぶん入っているので、いちばん小さい 1 つに絞る（展開後 305MB → 2MB）
SRC_PATTERN="地域海岸9."

SRC_SRS="auto"                      # → EPSG:2451
VALUE_FIELD="auto"                  # → z
VALUE_KIND="auto"                   # → depth
TILE_TYPE="auto"                    # → numeric（palette も選べる。下のコメント参照）
MESH_SIZE="auto"                    # → 10mメッシュ（頂点間隔 X 10m × Y 10m）

# 係数 0.01 は cm 単位で保持する意味。浸水深は 20m 程度までなので、
# 24 ビット符号付き整数（±83886.07 @ f=0.01）に対して桁は十分に余る。
NUM_FACTOR=0.01
NUM_OFFSET=0
NUM_UNIT="m"

MIN_ZOOM=9
MAX_ZOOM="auto"                     # → 17

DESCRIPTION="津波浸水想定 最大浸水深（地域海岸9）— 浸水深の実数値を保持する数値PNGタイル"
ATTRIBUTION="福島県 津波浸水想定（CC BY 2.1 JP）"

FETCH_URL="https://www.pref.fukushima.lg.jp/uploaded/attachment/623568.zip"
FETCH_CONTAINS="MAXALL_SHP/最大浸水深_0_最大包絡_R02_地域海岸9."
FETCH_FLATTEN="true"

# 同じデータをパレットPNGにする場合は、この 2 行に差し替える:
#   TILE_TYPE="palette"
#   RANK_DEF="colors/water-depth-8rank.json"
# 実数値の浸水深はしきい値でランクに分類できるので、どちらの出力も選べる。
# 逆にランクデータからは実数値を復元できないので、そちらは numeric を選べない。
