# 例4: 例3と同じ入力を、こんどはパレットPNGにする
#
# 元データが浸水深の実数値なら、パレットPNG も数値PNG も選べる。
# 例3（fukushima-depth-numeric）との差は TILE_TYPE と RANK_DEF の 2 行だけ。
# Step 2 が RANK_DEF のしきい値で実数値をランクに分類してからラスタライズする。
#
# 逆向き（ランクデータ → 数値PNG）はできない。ランクから実数値は復元できないため、
# TILE_TYPE="numeric" を指定すると Step 1 がエラーで止まる。
#
# ライセンス: CC BY 2.1 JP（福島県オープンデータ利用規約）

DATASET_ID="fukushima-depth-palette"
SRC_DIR="data/fukushima-depth"
SRC_PATTERN="地域海岸9."

SRC_SRS="auto"
VALUE_FIELD="auto"                  # → z
VALUE_KIND="auto"                   # → depth
MESH_SIZE="auto"                    # → 10mメッシュ

TILE_TYPE="palette"                 # ← 明示指定（auto なら numeric になる）
RANK_DEF="colors/water-depth-8rank.json"

MIN_ZOOM=9
MAX_ZOOM="auto"                     # → 17

DESCRIPTION="津波浸水想定 最大浸水深（地域海岸9）— 実数値を8ランクに分類したパレットPNGタイル"
ATTRIBUTION="福島県 津波浸水想定（CC BY 2.1 JP）"

FETCH_URL="https://www.pref.fukushima.lg.jp/uploaded/attachment/623568.zip"
FETCH_CONTAINS="MAXALL_SHP/最大浸水深_0_最大包絡_R02_地域海岸9."
FETCH_FLATTEN="true"
